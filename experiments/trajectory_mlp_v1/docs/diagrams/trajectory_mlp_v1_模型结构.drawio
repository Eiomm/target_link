          <mxGeometry x="1320" y="320" width="500" height="105" as="geometry" />
        </mxCell>
        <mxCell id="hcond" value="隐藏行条件 token&#10;mask token + ratio 编码&#10;不输入隐藏耗时与隐藏 bin_valid" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="500" width="500" height="115" as="geometry" />
        </mxCell>
        <mxCell id="states" value="可见轨迹 encoder 状态&#10;Linear 256→256，恢复原槽位" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="790" width="550" height="95" as="geometry" />
        </mxCell>
