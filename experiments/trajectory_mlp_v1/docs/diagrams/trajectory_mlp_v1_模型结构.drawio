          <mxGeometry x="60" y="980" width="400" height="95" as="geometry" />
        </mxCell>
        <mxCell id="restore" value="拼回全部轨迹行&#10;可见行：投影后的 encoder 状态&#10;隐藏行：mask token + ratio 编码&#10;各轨迹行再加共享时间编码" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="670" y="960" width="550" height="135" as="geometry" />
        </mxCell>
