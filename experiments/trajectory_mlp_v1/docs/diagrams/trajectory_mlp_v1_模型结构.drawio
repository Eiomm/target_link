        <mxCell id="title" value="Trajectory MLP MAE｜整条轨迹作为一个 token" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172554;fontSize=30;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;fontColor=#172554;align=left;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1780" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="对应 experiments/trajectory_mlp_v1/model.py｜默认 64 条/组，d=256，8 heads，encoder 4 层，decoder 2 层" style="rounded=1;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;fontColor=#475569;align=left;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="1780" height="40" as="geometry" />
        </mxCell>
        <mxCell id="select" value="先选择可见轨迹&#10;traj_valid AND NOT mae_mask" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="530" height="90" as="geometry" />
        </mxCell>
        <mxCell id="features" value="可见轨迹内容输入&#10;[T_clean, ratio, valid]，每条 50 × 3&#10;无效 T 清零，ratio 独立保留&#10;按固定 bin 顺序展平为 150 维" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="530" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mlp" value="轨迹 MLP&#10;Linear 150→256 → GELU → LN&#10;→ Dropout → Linear 256→256" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="530" height="110" as="geometry" />
        </mxCell>
        <mxCell id="add" value="加入可见轨迹的时间编码" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="660" width="530" height="65" as="geometry" />
        </mxCell>
        <mxCell id="enc" value="CLS + 可见轨迹 tokens&#10;4 层 Transformer Encoder → LN&#10;8 heads；d=256；FFN=1024" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F5F3FF;strokeColor=#A78BFA;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="530" height="115" as="geometry" />
        </mxCell>
        <mxCell id="time" value="共享时间编码（两种配置）&#10;seconds：delta_t/600 → MLP&#10;bucket30：30 秒一桶 → 20 桶 Embedding&#10;编码器与解码器共享参数" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EFF6FF;strokeColor=#60A5FA;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="330" width="480" height="135" as="geometry" />
        </mxCell>
        <mxCell id="hidden" value="隐藏轨迹&#10;使用共享可学习 mask token" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=1.5;fontColor=#172554;fontSize=18;fontFamily=Helvetica;align=center;verticalAlign=middle;spacing=14;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="1320" y="180" width="500" height="90" as="geometry" />
        </mxCell>
